// freqlab:licensing-begin
/// Persistent state for the license UI, threaded through
/// `create_egui_editor`'s user_state. `last_error` is Arc<Mutex>
/// because worker threads write to it; everything else is only
/// touched on the GUI thread.
#[derive(Default)]
struct LicenseUiState {
    key_input: String,
    modal_open: bool,
    busy: Arc<AtomicBool>,
    last_error: Arc<Mutex<Option<String>>>,
}

// freqlab:licensing-end
/// {{description}}
struct {{struct_name}} {
    params: Arc<{{struct_name}}Params>,
}

#[derive(Params)]
struct {{struct_name}}Params {
    #[persist = "editor-state"]
    editor_state: Arc<EguiState>,

    #[id = "gain"]
    pub gain: FloatParam,
}

impl Default for {{struct_name}} {
    fn default() -> Self {
        Self {
            params: Arc::new({{struct_name}}Params::default()),
        }
    }
}

impl Default for {{struct_name}}Params {
    fn default() -> Self {
        Self {
            editor_state: EguiState::from_size(400, 300),
            gain: FloatParam::new(
                "Gain",
                util::db_to_gain(0.0),
                FloatRange::Skewed {
                    min: util::db_to_gain(-30.0),
                    max: util::db_to_gain(30.0),
                    factor: FloatRange::gain_skew_factor(-30.0, 30.0),
                },
            )
            .with_smoother(SmoothingStyle::Logarithmic(50.0))
            .with_unit(" dB")
            .with_value_to_string(formatters::v2s_f32_gain_to_db(2))
            .with_string_to_value(formatters::s2v_f32_gain_to_db()),
        }
    }
}

impl Plugin for {{struct_name}} {
    const NAME: &'static str = "{{pascal_name}}";
    const VENDOR: &'static str = "{{vendor_name}}";
    const URL: &'static str = "{{vendor_url}}";
    const EMAIL: &'static str = "{{vendor_email}}";
    const VERSION: &'static str = env!("CARGO_PKG_VERSION");

    // Stereo first (the default), then mono for mono tracks
    const AUDIO_IO_LAYOUTS: &'static [AudioIOLayout] = &[
        AudioIOLayout {
            main_input_channels: NonZeroU32::new(2),
            main_output_channels: NonZeroU32::new(2),
            ..AudioIOLayout::const_default()
        },
        AudioIOLayout {
            main_input_channels: NonZeroU32::new(1),
            main_output_channels: NonZeroU32::new(1),
            ..AudioIOLayout::const_default()
        },
    ];

    const MIDI_INPUT: MidiConfig = MidiConfig::None;
    const MIDI_OUTPUT: MidiConfig = MidiConfig::None;

    type SysExMessage = ();
    type BackgroundTask = ();

    fn params(&self) -> Arc<dyn Params> {
        self.params.clone()
    }

    fn editor(&mut self, _async_executor: AsyncExecutor<Self>) -> Option<Box<dyn Editor>> {
        // freqlab:licensing-begin
        // Refresh when the editor opens so the UI shows the latest
        // state from the server, not an older one. The blocking disk and
        // HTTPS call runs on a worker; it does nothing in stub builds.
        std::thread::spawn(|| { let _ = licensing::refresh(); });

        // freqlab:licensing-end
        let params = self.params.clone();

        create_egui_editor(
            self.params.editor_state.clone(),
            // freqlab:licensing-begin
            LicenseUiState::default(),
            // freqlab:licensing-else
            (),
            // freqlab:licensing-end
            |_, _| {},
            // freqlab:licensing-begin
            move |egui_ctx, setter, state| {
            // freqlab:licensing-else
            move |egui_ctx, setter, _state| {
            // freqlab:licensing-end
                // freqlab:licensing-begin
                // SDK status is a lock-free atomic read; safe to call
                // every frame.  NoConfig means the stub is wired up
                // but no licensing config has been injected, so we
                // hide every license affordance.
                let info = licensing::current();
                let licensing_active = info.status != licensing::Status::NoConfig;

                // Banner across the top for bad license states.
                let needs_banner = matches!(
                    info.status,
                    licensing::Status::NotActivated
                        | licensing::Status::Expired
                        | licensing::Status::Tampered
                );
                if licensing_active && needs_banner {
                    let (bg, copy) = match info.status {
                        licensing::Status::NotActivated => (
                            egui::Color32::from_rgb(70, 40, 0),
                            "This plugin is not activated.  Click to enter your license key.",
                        ),
                        licensing::Status::Expired => (
                            egui::Color32::from_rgb(70, 20, 20),
                            "Your license has expired.  Renew to continue using this plugin.",
                        ),
                        licensing::Status::Tampered => (
                            egui::Color32::from_rgb(45, 15, 70),
                            "License could not be verified.  Please reinstall the plugin.",
                        ),
                        _ => (egui::Color32::TRANSPARENT, ""),
                    };
                    let banner = egui::TopBottomPanel::top("freqlab_license_banner")
                        .frame(egui::Frame::new().fill(bg))
                        .resizable(false)
                        .exact_height(24.0);
                    banner.show(egui_ctx, |ui| {
                        let response = ui.allocate_response(ui.available_size(), egui::Sense::click());
                        let rect = response.rect;
                        ui.painter().text(
                            rect.center(),
                            egui::Align2::CENTER_CENTER,
                            copy,
                            egui::FontId::proportional(12.0),
                            egui::Color32::from_rgb(255, 230, 200),
                        );
                        if response.clicked() {
                            state.modal_open = true;
                        }
                    });
                }

                // Pill in the top-right corner.  Custom-painted because
                // we want a rounded background + colored dot + label
                // in a single clickable region.
                if licensing_active {
                    let (dot_colour, label) = match info.status {
                        licensing::Status::Licensed     => (egui::Color32::from_rgb( 68, 255, 136), "Licensed"),
                        licensing::Status::Trial        => (egui::Color32::from_rgb(102, 204, 255), "Trial"),
                        licensing::Status::GracePeriod  => (egui::Color32::from_rgb(255, 204,  68), "Expiring soon"),
                        licensing::Status::Overdue      => (egui::Color32::from_rgb(255, 204,  68), "Re-syncing"),
                        licensing::Status::Expired      => (egui::Color32::from_rgb(255, 102,  85), "Expired"),
                        licensing::Status::NotActivated => (egui::Color32::from_rgb(255, 170,  68), "Not activated"),
                        licensing::Status::Tampered     => (egui::Color32::from_rgb(187,  85, 255), "License invalid"),
                        licensing::Status::NoConfig     => (egui::Color32::TRANSPARENT, ""),
                    };
                    let area = egui::Area::new(egui::Id::new("freqlab_license_pill"))
                        .order(egui::Order::Foreground)
                        .anchor(egui::Align2::RIGHT_TOP, egui::vec2(-8.0, if needs_banner { 28.0 } else { 6.0 }));
                    area.show(egui_ctx, |ui| {
                        let desired = egui::vec2(120.0, 18.0);
                        let (rect, response) = ui.allocate_exact_size(desired, egui::Sense::click());
                        let painter = ui.painter();
                        painter.rect_filled(rect, 9.0, egui::Color32::from_black_alpha(160));
                        painter.rect_stroke(
                            rect.shrink(0.5),
                            9.0,
                            egui::Stroke::new(1.0, dot_colour.linear_multiply(0.4)),
                            egui::StrokeKind::Middle,
                        );
                        let dot_r = rect.height() * 0.28;
                        let dot_centre = egui::pos2(rect.left() + dot_r + 6.0, rect.center().y);
                        painter.circle_filled(dot_centre, dot_r, dot_colour);
                        painter.text(
                            egui::pos2(rect.left() + dot_r * 2.0 + 12.0, rect.center().y),
                            egui::Align2::LEFT_CENTER,
                            label,
                            egui::FontId::proportional(10.0),
                            dot_colour,
                        );
                        if response.clicked() {
                            state.modal_open = true;
                        }
                    });
                }

                // freqlab:licensing-end
                // Main UI.
                egui::CentralPanel::default()
                    .frame(egui::Frame::new().fill(egui::Color32::from_rgb(26, 26, 46)))
                    .show(egui_ctx, |ui| {
                        ui.vertical_centered(|ui| {
                            ui.add_space(20.0);
                            ui.heading("{{pascal_name}}");
                            ui.add_space(30.0);

                            ui.horizontal(|ui| {
                                ui.label("Gain:");
                                ui.add(widgets::ParamSlider::for_param(&params.gain, setter));
                            });
                        });
                    });
                // freqlab:licensing-begin

                // The license panel: only after a click on the pill
                // or banner, and only when licensing is configured.
                if state.modal_open && licensing_active {
                    let modal = egui::Window::new("License")
                        .collapsible(false)
                        .resizable(false)
                        .anchor(egui::Align2::CENTER_CENTER, egui::vec2(0.0, 0.0))
                        .default_width(280.0);
                    modal.show(egui_ctx, |ui| {
                        let is_licensed = info.status == licensing::Status::Licensed;
                        let busy_now = state.busy.load(Ordering::Relaxed);

                        // Status pill at the top of the modal.
                        let (status_colour, status_label) = match info.status {
                            licensing::Status::Licensed     => (egui::Color32::from_rgb( 68, 255, 136), "LICENSED"),
                            licensing::Status::Trial        => (egui::Color32::from_rgb(102, 204, 255), "TRIAL"),
                            licensing::Status::GracePeriod  => (egui::Color32::from_rgb(255, 204,  68), "EXPIRING SOON"),
                            licensing::Status::Overdue      => (egui::Color32::from_rgb(255, 204,  68), "RE-SYNCING"),
                            licensing::Status::Expired      => (egui::Color32::from_rgb(255, 102,  85), "EXPIRED"),
                            licensing::Status::NotActivated => (egui::Color32::from_rgb(255, 170,  68), "NOT ACTIVATED"),
                            licensing::Status::Tampered     => (egui::Color32::from_rgb(187,  85, 255), "LICENSE INVALID"),
                            licensing::Status::NoConfig     => (egui::Color32::GRAY, "UNKNOWN"),
                        };
                        ui.colored_label(
                            status_colour,
                            if busy_now { "WORKING..." } else { status_label },
                        );
                        ui.add_space(8.0);

                        if !is_licensed {
                            ui.add(
                                egui::TextEdit::singleline(&mut state.key_input)
                                    .hint_text("XXXX-XXXX-XXXX-XXXX")
                                    .desired_width(f32::INFINITY),
                            );
                            ui.add_space(8.0);
                        }

                        ui.horizontal(|ui| {
                            if !is_licensed {
                                let activate = egui::Button::new("ACTIVATE");
                                if ui.add_enabled(!busy_now, activate).clicked() {
                                    let key = state.key_input.trim().to_string();
                                    if key.is_empty() {
                                        if let Ok(mut slot) = state.last_error.lock() {
                                            *slot = Some("Enter a license key first".to_string());
                                        }
                                    } else {
                                        state.busy.store(true, Ordering::Relaxed);
                                        let busy = state.busy.clone();
                                        let err = state.last_error.clone();
                                        std::thread::spawn(move || {
                                            let result = licensing::validate_and_activate(&key);
                                            if let Ok(mut slot) = err.lock() {
                                                *slot = result.err().map(|e| format!("{}", e));
                                            }
                                            busy.store(false, Ordering::Relaxed);
                                        });
                                    }
                                }
                            }
                            let deactivate = egui::Button::new("DEACTIVATE");
                            let allow_deact = !busy_now
                                && info.status != licensing::Status::NotActivated
                                && info.status != licensing::Status::NoConfig;
                            if ui.add_enabled(allow_deact, deactivate).clicked() {
                                state.busy.store(true, Ordering::Relaxed);
                                let busy = state.busy.clone();
                                let err = state.last_error.clone();
                                std::thread::spawn(move || {
                                    let result = licensing::deactivate_this_machine();
                                    if let Ok(mut slot) = err.lock() {
                                        *slot = result.err().map(|e| format!("{}", e));
                                    }
                                    busy.store(false, Ordering::Relaxed);
                                });
                            }
                            if ui.button("Close").clicked() {
                                state.modal_open = false;
                            }
                        });

                        // Error line below the buttons.
                        if let Ok(slot) = state.last_error.lock() {
                            if let Some(err) = slot.as_ref() {
                                ui.add_space(4.0);
                                ui.colored_label(egui::Color32::from_rgb(255, 102, 136), err);
                            }
                        }
                    });
                }
                // freqlab:licensing-end
            },
        )
    }

    fn initialize(
        &mut self,
        _audio_io_layout: &AudioIOLayout,
        _buffer_config: &BufferConfig,
        _context: &mut impl InitContext<Self>,
    ) -> bool {
        // freqlab:licensing-begin
        // Sync the SDK cache against the server on plugin load.
        // refresh() blocks (disk + HTTP) so it runs on a worker
        // thread. No-op in stub builds (returns NoConfig).
        std::thread::spawn(|| { let _ = licensing::refresh(); });

        // freqlab:licensing-end
        true
    }

    // freqlab:licensing-begin
    // The `@freqlab:require-license` marker tells our cloud
    // transformer to wrap this function with a license gate at
    // build time. The inline `freqlab_should_run_dsp(buffer)`
    // call below makes the same gate run during local development
    // too, so the plugin silences correctly without a cloud build.
    //
    // @freqlab:require-license
    // freqlab:licensing-end
    fn process(
        &mut self,
        buffer: &mut Buffer,
        _aux: &mut AuxiliaryBuffers,
        _context: &mut impl ProcessContext<Self>,
    ) -> ProcessStatus {
        // freqlab:licensing-begin
        if !freqlab_should_run_dsp(buffer) {
            return ProcessStatus::Normal;
        }

        // freqlab:licensing-end
        for channel_samples in buffer.iter_samples() {
            let gain = self.params.gain.smoothed.next();
            for sample in channel_samples {
                *sample *= gain;
                // Protect against NaN/Inf (can crash DAWs)
                if !sample.is_finite() {
                    *sample = 0.0;
                }
            }
        }
        // freqlab:licensing-begin
        // The cloud transformer injects freqlab_dsp_fold(buffer) here; it is the
        // identity in all licensed builds and only mangles audio in an enforced
        // cloud build when the license is bypassed.
        // @freqlab:dsp-fold

        // freqlab:licensing-end
        ProcessStatus::Normal
    }
}

// freqlab:licensing-begin
impl Drop for {{struct_name}} {
    fn drop(&mut self) {
        // Flip the SDK's cancellation flag so any in-flight refresh /
        // activate / deactivate worker bails at its next checkpoint
        // before the host unloads us.  This template fires-and-forgets
        // its workers; a plugin that stores JoinHandles should also
        // `.join()` them here after calling `shutdown()`.
        licensing::shutdown();
    }
}

