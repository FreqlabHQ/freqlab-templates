#pragma once

#include "IPlug_include_in_plug_hdr.h"

#include <atomic>
#include <mutex>
#include <string>

// Parameter indices
enum EParams {
    kGain = 0,
    kNumParams
};

class {{class_name}} final : public iplug::Plugin {
public:
    {{class_name}}(const iplug::InstanceInfo& info);
    ~{{class_name}}() override;

    void OnReset() override;
    void OnParamChange(int paramIdx) override;
    void ProcessBlock(iplug::sample** inputs, iplug::sample** outputs, int nFrames) override;

    // Custom messages from the WebView UI (license activate /
    // deactivate / query).  See PluginProcessor.cpp for the
    // 4cc msgTag constants and dispatch logic.
    bool OnMessage(int msgTag, int ctrlTag, int dataSize, const void* pData) override;
    void ProcessMidiMsg(const iplug::IMidiMsg& msg) override;

    // Fires after the WebView finishes loading ui.html.  This is the
    // correct moment to push initial license state (mEditorInitFunc
    // races with the async LoadFile and loses).
    void OnWebContentLoaded() override;

    // Main thread, called regularly: sends license state the SDK's callbacks left pending
    void OnIdle() override;

    // A drag in the UI is one host gesture; tracked so closing the editor mid-drag still ends it
    void BeginInformHostOfParamChangeFromUI(int paramIdx) override;
    void EndInformHostOfParamChangeFromUI(int paramIdx) override;
    void* OpenWindow(void* pParent) override;
    void CloseWindow() override;

private:
    // The gain knob, in amplitude: written from the host or UI thread, read on the audio thread
    std::atomic<double> mGain{1.0};
    double mSmoothedGain = 1.0;
    double mSmoothCoeff = 0.001;

    // MIDI waiting for its sample in the block (see ProcessMidiMsg)
    iplug::IMidiQueue mMidiQueue;
    static constexpr int kMaxQueuedMidi = 1024;
    void HandleMidi(const iplug::IMidiMsg& msg);

    // Simple oscillator state
    double mPhase = 0.0;
    double mFreq = 0.0;
    double mVelocity = 0.0;
    // The velocity mVelocity moves to: a note that starts while the last one fades out glides to
    // its level instead of jumping (a jump clicks)
    double mTargetVelocity = 0.0;
    bool mNoteOn = false;
    int mNote = -1;
    // Fade level, 0 (silent) to 1 (full); a note fades in over kAttackSeconds and out over
    // kReleaseSeconds once its key is up
    double mEnvelope = 0.0;
    static constexpr double kAttackSeconds = 0.005;
    static constexpr double kReleaseSeconds = 0.05;
    // Base output level (-6 dB) so 0 dB gain is a comfortable listening level
    static constexpr double kVoiceLevel = 0.5;

    // Helper: read freqlab::licensing::current() and push a JSON
    // license_state message to the WebView so the UI can refresh.
    void PushLicenseStateToUI();

    // Last activation / deactivation error, surfaced to the UI on
    // the next state push.  Mutex guards cross-thread writes from
    // the worker threads spawned in OnMessage().
    std::mutex mLicenseErrorMutex;
    std::string mLicenseError;

    // Set by the licensing SDK's callbacks (its worker thread); OnIdle() pushes the new state
    // to the web view from the main thread
    std::atomic<bool> mLicenseStatePending{false};

    // The parameter a UI drag is changing (-1: none)
    int mGestureParam = -1;

    // Windows: the message shown instead of the UI when WebView2 isn't installed (an HWND)
    void* mWebViewMissing = nullptr;
};
