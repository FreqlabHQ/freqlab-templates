namespace {
// Four-character-code (FOURCC) constants used to tag custom
// SAMFUI / SAMFD messages exchanged with the WebView UI.  Layout
// is fixed (big-endian char packing) so JS and C++ agree on the
// integer value of e.g. 'lact'.  Defined as plain int hex literals
// to avoid the implementation-defined ordering of `'lact'`.
constexpr int kMsgLicenseActivate   = 0x6C616374; // 'lact'
constexpr int kMsgLicenseDeactivate = 0x6C646563; // 'ldec'
constexpr int kMsgLicenseQuery      = 0x6C717279; // 'lqry'
constexpr int kMsgLicenseState      = 0x6C737474; // 'lstt'

// Tiny JSON-encoding helper for plain strings.  We avoid pulling
// in a full JSON library because the wire format is fixed.
std::string EscapeJson(const std::string& s) {
    // 0x5C == '\' and 0x22 == '"' literals avoid any
    // source-encoding ambiguity around backslash escapes.
    static constexpr char kBackslash = static_cast<char>(0x5C);
    static constexpr char kQuote     = static_cast<char>(0x22);
    std::string out;
    out.reserve(s.size() + 2);
    for (char c : s) {
        if (c == kBackslash) {
            out += kBackslash;
            out += kBackslash;
        } else if (c == kQuote) {
            out += kBackslash;
            out += kQuote;
        } else if (c == 0x0A) {  // newline
            out += kBackslash;
            out += 'n';
        } else if (c == 0x0D) {  // carriage return
            out += kBackslash;
            out += 'r';
        } else if (c == 0x09) {  // tab
            out += kBackslash;
            out += 't';
        } else if (static_cast<unsigned char>(c) < 0x20) {
            char buf[8];
            std::snprintf(buf, sizeof(buf), "%cu%04x",
                          kBackslash, static_cast<unsigned int>(c));
            out += buf;
        } else {
            out += c;
        }
    }
    return out;
}

// Read a JSON-quoted string value for `key` out of `payload`.
// Used only to extract the license-key field from the activate
// message; for production parsing use a real JSON library.
std::string ExtractJsonStringField(const std::string& payload, const char* key) {
    std::string needle = std::string("\"") + key + "\"";
    auto k = payload.find(needle);
    if (k == std::string::npos) return {};
    auto colon = payload.find(':', k + needle.size());
    if (colon == std::string::npos) return {};
    auto open_q = payload.find('"', colon);
    if (open_q == std::string::npos) return {};
    auto close_q = payload.find('"', open_q + 1);
    if (close_q == std::string::npos) return {};
    return payload.substr(open_q + 1, close_q - open_q - 1);
}
}  // namespace

{{class_name}}::{{class_name}}(const InstanceInfo& info)
    : iplug::Plugin(info, MakeConfig(kNumParams, 1))  // params, presets
{
    // Define parameters
    GetParam(kGain)->InitDouble("Gain", 0., -30., 30., 0.1, "dB");

    // Initialize cached values
    mGain = DBToAmp(GetParam(kGain)->Value());

    // Sync the SDK cache against the server when the plugin loads.
    // refreshAsync() returns immediately and does the blocking HTTPS
    // call on the SDK's worker thread. No-op in stub builds.
    freqlab::licensing::refreshAsync();

#if IPLUG_EDITOR
    // WebView editor setup - load bundled HTML
    // (iPlug2 cuts scripts at 8 KB; the parameter list it sends the page grows with each parameter)
    SetMaxJSStringLength(1 << 16);

    mEditorInitFunc = [&]() {
#if defined(OS_WIN)
        // On Windows, LoadFile needs an absolute path (no app bundle)
        WDL_String pluginPath;
        PluginPath(pluginPath, gHINSTANCE);
        WDL_String webPath;
        webPath.Set(pluginPath.Get());
        // Per-plugin folder, named by CMakeLists.txt: flat plugins in one folder share its resources folder
        webPath.Append("resources\\" WEB_RESOURCES_DIR_NAME "\\web\\ui.html");
        LoadFile(webPath.Get(), nullptr);
        // iPlug2's OpenWebView ignores width/height params on Windows, leaving
        // the WebView2 control at zero size. Explicitly set bounds here so the
        // content is visible in all plugin formats (VST3, CLAP, standalone).
        Resize(GetEditorWidth(), GetEditorHeight());
#else
        // On macOS (and other bundle-based formats), use bundle ID to find resources
        LoadFile("ui.html", GetBundleID());
#endif
        // The first license-state push waits for OnWebContentLoaded:
        // LoadFile is async, so a SendArbitraryMsgFromDelegate
        // from here fires into a WebView that hasn't parsed our JS
        // yet and is silently dropped.
    };
#endif
}

void {{class_name}}::OnWebContentLoaded() {
    // Let iPlug2 do its standard post-load work first: this sends
    // the parameter list as JSON and invokes OnUIOpen() (which
    // syncs current param values).  Skipping the base call would
    // break standard parameter sync to the UI.
    iplug::Plugin::OnWebContentLoaded();

    // Now that the page is parsed and our JS has registered SAMFD,
    // push the current license state to the pill and banner. The
    // page's DOMContentLoaded query is a fallback for this push.
    PushLicenseStateToUI();
}

void {{class_name}}::OnIdle() {
    // The licensing SDK calls back on its own worker thread, and the web view must only be
    // touched from the main thread, which runs this
    if (mLicenseStatePending.exchange(false))
        PushLicenseStateToUI();
}

void {{class_name}}::BeginInformHostOfParamChangeFromUI(int paramIdx) {
    mGestureParam = paramIdx;
    iplug::Plugin::BeginInformHostOfParamChangeFromUI(paramIdx);
}

void {{class_name}}::EndInformHostOfParamChangeFromUI(int paramIdx) {
    mGestureParam = -1;
    iplug::Plugin::EndInformHostOfParamChangeFromUI(paramIdx);
}

void* {{class_name}}::OpenWindow(void* pParent) {
#if defined(OS_WIN)
    // Without the WebView2 runtime the UI can't open: say so instead
    LPWSTR version = nullptr;
    if (FAILED(GetAvailableCoreWebView2BrowserVersionString(nullptr, &version)) || version == nullptr) {
        // (the host's window in physical pixels: larger than the editor size on a scaled display)
        RECT bounds{0, 0, GetEditorWidth(), GetEditorHeight()};
        GetClientRect(static_cast<HWND>(pParent), &bounds);
        mWebViewMissing = CreateWindowExW(0, L"STATIC",
            L"This plugin's window needs the Microsoft Edge WebView2 Runtime, a free download from "
            L"Microsoft. Install it, then reopen this window. The plugin's sound keeps working.",
            WS_CHILD | WS_VISIBLE | SS_CENTER, 0, 0, bounds.right - bounds.left, bounds.bottom - bounds.top,
            static_cast<HWND>(pParent), nullptr, gHINSTANCE, nullptr);
        SendMessageW(static_cast<HWND>(mWebViewMissing), WM_SETFONT,
                     reinterpret_cast<WPARAM>(GetStockObject(DEFAULT_GUI_FONT)), TRUE);
        return pParent;
    }
    CoTaskMemFree(version);
#endif
    return iplug::Plugin::OpenWindow(pParent);
}

void {{class_name}}::CloseWindow() {
    // (closed mid-drag: the host's gesture still ends)
    if (mGestureParam >= 0)
        iplug::Plugin::EndInformHostOfParamChangeFromUI(std::exchange(mGestureParam, -1));
#if defined(OS_WIN)
    if (mWebViewMissing) {
        DestroyWindow(static_cast<HWND>(mWebViewMissing));
        mWebViewMissing = nullptr;
    }
#endif
    iplug::Plugin::CloseWindow();
}

{{class_name}}::~{{class_name}}() {
    // Block until any in-flight SDK worker has exited so the host can
    // safely unload the plugin dylib.  Stub builds make this a no-op.
    freqlab::licensing::shutdown();
}

void {{class_name}}::OnReset() {
    // A reset (processing restart, sample rate change, host reset) ends any note still sounding
    mMidiQueue.Resize(std::max(GetBlockSize(), kMaxQueuedMidi));
    mMidiQueue.Clear();
    mSmoothCoeff = 1.0 - std::exp(-1.0 / (0.02 * GetSampleRate()));
    mSmoothedGain = mGain.load();
    mPhase = 0.0;
    mNoteOn = false;
    mEnvelope = 0.0;
    // The release fade outlasts the input: the host mustn't put the plugin to sleep before it ends
    SetTailSize(static_cast<int>(std::ceil(kReleaseSeconds * GetSampleRate())));
}

void {{class_name}}::OnParamChange(int paramIdx) {
    switch (paramIdx) {
        case kGain:
            mGain = DBToAmp(GetParam(kGain)->Value());
            break;
    }
}

void {{class_name}}::ProcessMidiMsg(const IMidiMsg& msg) {
    // Queued, and handled in ProcessBlock at the sample it's timed for (msg.mOffset)
    if (mMidiQueue.ToDo() >= kMaxQueuedMidi)
        mMidiQueue.Clear();
    mMidiQueue.Add(msg);
}

void {{class_name}}::HandleMidi(const IMidiMsg& msg) {
    switch (msg.StatusMsg()) {
        case IMidiMsg::kNoteOn:
            if (msg.Velocity() > 0) {
                mNote = msg.NoteNumber();
                mFreq = 440.0 * std::pow(2.0, (mNote - 69) / 12.0);
                mTargetVelocity = msg.Velocity() / 127.0;
                // From silence it starts at its level (the fade in covers it)
                if (mEnvelope == 0.0)
                    mVelocity = mTargetVelocity;
                mNoteOn = true;
            } else if (msg.NoteNumber() == mNote) {
                mNoteOn = false;
            }
            break;
        case IMidiMsg::kNoteOff:
            // Only the note that's playing: releasing an earlier key leaves it sounding
            if (msg.NoteNumber() == mNote)
                mNoteOn = false;
            break;
        default:
            break;
    }
}

// The `@freqlab:require-license` marker tells our cloud transformer
// to wrap this function with a license gate at build time. The inline
// `freqlab_should_run_dsp(...)` call below makes the same gate run
// during local development too, so the plugin silences correctly
// without a cloud build.
//
// @freqlab:require-license
void {{class_name}}::ProcessBlock(sample** /*inputs*/, sample** outputs, int nFrames) {
    const int nChans = NOutChansConnected();
    if (!freqlab_should_run_dsp(outputs, nChans, nFrames)) {
        // (the skipped MIDI may hold a note's release: no note left hanging)
        mMidiQueue.Clear();
        mNoteOn = false;
        mEnvelope = 0.0;
        return;
    }

    const double sampleRate = GetSampleRate();
    const double targetGain = mGain.load();

    // A short fade in and out, so notes start and stop without a click
    const double attackStep = 1.0 / (kAttackSeconds * sampleRate);
    const double releaseStep = 1.0 / (kReleaseSeconds * sampleRate);

    for (int s = 0; s < nFrames; s++) {
        while (!mMidiQueue.Empty() && mMidiQueue.Peek().mOffset <= s) {
            HandleMidi(mMidiQueue.Peek());
            mMidiQueue.Remove();
        }

        // Glides to the knob's value, so moving it doesn't crackle
        mSmoothedGain += mSmoothCoeff * (targetGain - mSmoothedGain);
        const double gain = mSmoothedGain;
        double out = 0.0;

        mEnvelope = mNoteOn ? std::min(1.0, mEnvelope + attackStep) : std::max(0.0, mEnvelope - releaseStep);

        // A new note's level is reached over the same short time
        mVelocity += std::clamp(mTargetVelocity - mVelocity, -attackStep, attackStep);

        if (mEnvelope > 0.0 && mFreq > 0.0) {
            // Simple sine wave oscillator
            out = std::sin(mPhase * 2.0 * M_PI) * mVelocity * mEnvelope * gain * kVoiceLevel;
            mPhase += mFreq / sampleRate;
            if (mPhase >= 1.0) mPhase -= 1.0;
        }

        if (!std::isfinite(out)) {
            out = 0.0;
        }

        for (int c = 0; c < nChans; c++) {
            outputs[c][s] = out;
        }
    }

    mMidiQueue.Flush(nFrames);

    // The cloud transformer injects freqlab_dsp_fold(outputs, nChans, nFrames)
    // here; it is the identity in all licensed builds and only mangles audio
    // in an enforced cloud build when the license is bypassed.
    // @freqlab:dsp-fold
}

bool {{class_name}}::OnMessage(int msgTag, int /*ctrlTag*/, int dataSize, const void* pData) {
    // The WebView UI sends FOURCC-tagged messages here.  The payload
    // (pData / dataSize) is the UTF-8 string the JS code put in the
    // `data` field of the SAMFUI envelope.  Return true when we
    // handled the message so the base class doesn't double-dispatch.
    const std::string payload =
        (pData && dataSize > 0)
            ? std::string(static_cast<const char*>(pData), static_cast<size_t>(dataSize))
            : std::string{};

    if (msgTag == kMsgLicenseQuery) {
        PushLicenseStateToUI();
        return true;
    }

    if (msgTag == kMsgLicenseDeactivate) {
        {
            std::lock_guard<std::mutex> lock(mLicenseErrorMutex);
            mLicenseError.clear();
        }
        // SDK runs the call on its own worker; callback fires when
        // the deactivation result is in.  We push fresh state from
        // there so the UI updates without polling.
        freqlab::licensing::deactivateThisMachine(
            [this](bool ok) {
                if (!ok) {
                    std::lock_guard<std::mutex> lock(mLicenseErrorMutex);
                    mLicenseError = "Deactivation failed";
                }
                mLicenseStatePending = true;
            });
        return true;
    }

    if (msgTag == kMsgLicenseActivate) {
        const std::string key = ExtractJsonStringField(payload, "key");
        if (key.empty()) {
            {
                std::lock_guard<std::mutex> lock(mLicenseErrorMutex);
                mLicenseError = "Enter a license key first";
            }
            PushLicenseStateToUI();
            return true;
        }
        {
            std::lock_guard<std::mutex> lock(mLicenseErrorMutex);
            mLicenseError.clear();
        }
        freqlab::licensing::validateAndActivate(
            key,
            [this](freqlab::licensing::LicenseInfo /*info*/) {
                mLicenseStatePending = true;
            },
            [this](std::string err) {
                {
                    std::lock_guard<std::mutex> lock(mLicenseErrorMutex);
                    mLicenseError = std::move(err);
                }
                mLicenseStatePending = true;
            });
        return true;
    }

    // Unrecognized msgTag; let the base class try.
    return false;
}

void {{class_name}}::PushLicenseStateToUI() {
    const auto status = freqlab::licensing::currentStatus();

    const char* status_str = "NoConfig";
    switch (status) {
        case freqlab::licensing::Status::Licensed:     status_str = "Licensed";     break;
        case freqlab::licensing::Status::Trial:        status_str = "Trial";        break;
        case freqlab::licensing::Status::GracePeriod:  status_str = "GracePeriod";  break;
        case freqlab::licensing::Status::Overdue:      status_str = "Overdue";      break;
        case freqlab::licensing::Status::Expired:      status_str = "Expired";      break;
        case freqlab::licensing::Status::NotActivated: status_str = "NotActivated"; break;
        case freqlab::licensing::Status::Tampered:     status_str = "Tampered";     break;
        case freqlab::licensing::Status::NoConfig:     status_str = "NoConfig";     break;
    }
    const bool active = status != freqlab::licensing::Status::NoConfig;

    std::string error_copy;
    {
        std::lock_guard<std::mutex> lock(mLicenseErrorMutex);
        error_copy = mLicenseError;
    }

    // JSON shape kept narrow: {active, status, error}.  If your plugin
    // wants to surface license-key prefix or features, extend the SDK
    // success callback above to stash those fields, then add them
    // here.
    std::ostringstream json;
    json << "{"
         << "\"active\":" << (active ? "true" : "false") << ","
         << "\"status\":\"" << status_str << "\","
         << "\"error\":" << (error_copy.empty() ? "null" : ("\"" + EscapeJson(error_copy) + "\""))
         << "}";

    const std::string js_payload = json.str();
    SendArbitraryMsgFromDelegate(kMsgLicenseState,
                                 static_cast<int>(js_payload.size()),
                                 js_payload.data());
}

