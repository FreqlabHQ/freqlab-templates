using namespace iplug;

{{class_name}}::{{class_name}}(const InstanceInfo& info)
    : iplug::Plugin(info, MakeConfig(kNumParams, 1))  // params, presets
{
    // Define parameters
    GetParam(kGain)->InitDouble("Gain", 0., -30., 30., 0.1, "dB");

    // Initialize cached values
    mGain = DBToAmp(GetParam(kGain)->Value());
    // freqlab:licensing-begin

    // Sync the SDK cache against the server when the plugin loads.
    // refreshAsync() returns immediately and does the blocking HTTPS
    // call on the SDK's worker thread. No-op in stub builds.
    freqlab::licensing::refreshAsync();
    // freqlab:licensing-end
}

{{class_name}}::~{{class_name}}() {
    // freqlab:licensing-begin
    // Block until any in-flight SDK worker has exited so the host can
    // safely unload the plugin dylib.  Stub builds make this a no-op.
    freqlab::licensing::shutdown();
    // freqlab:licensing-end
}

void {{class_name}}::OnReset() {
    // Called when sample rate or block size changes: gain glides over about 20 ms at this rate
    mSmoothCoeff = 1.0 - std::exp(-1.0 / (0.02 * GetSampleRate()));
    mSmoothedGain = mGain.load();
}

void {{class_name}}::OnParamChange(int paramIdx) {
    switch (paramIdx) {
        case kGain:
            mGain = DBToAmp(GetParam(kGain)->Value());
            break;
    }
}

// freqlab:licensing-begin
// The `@freqlab:require-license` marker tells our cloud transformer
// to wrap this function with a license gate at build time. The inline
// `freqlab_should_run_dsp(...)` call below makes the same gate run
// during local development too, so the plugin silences correctly
// without a cloud build.
//
// @freqlab:require-license
// freqlab:licensing-end
void {{class_name}}::ProcessBlock(sample** inputs, sample** outputs, int nFrames) {
    const int nChans = NOutChansConnected();
    // freqlab:licensing-begin
    if (!freqlab_should_run_dsp(outputs, nChans, nFrames))
        return;

    // freqlab:licensing-end
    const double target = mGain.load();

    for (int s = 0; s < nFrames; s++) {
        // Glides to the knob's value, so moving it doesn't crackle
        mSmoothedGain += mSmoothCoeff * (target - mSmoothedGain);
        const double gain = mSmoothedGain;
        for (int c = 0; c < nChans; c++) {
            double samp = inputs[c][s];
            samp *= gain;

            if (!std::isfinite(samp)) {
                samp = 0.0;
            }

            outputs[c][s] = samp;
        }
    }
    // freqlab:licensing-begin

    // The cloud transformer injects freqlab_dsp_fold(outputs, nChans, nFrames)
    // here; it is the identity in all licensed builds and only mangles audio
    // in an enforced cloud build when the license is bypassed.
    // @freqlab:dsp-fold
    // freqlab:licensing-end
}
